# Copie este arquivo para .env e preencha na sua máquina.
# O .env não entra no Git. Nenhum valor abaixo é uma credencial real.

# Servidor da API
PORT=3000

# Origens do front, separadas por vírgula.
# Local: http://127.0.0.1:4173
# Publicado: https://lfkcc.github.io
CORS_ORIGIN=http://127.0.0.1:4173

# Postgres. No Supabase, use a connection string "Session pooler"
# (host pooler.supabase.com, usuário postgres.SEU-PROJETO).
# A conexão direta db.SEU-PROJETO.supabase.co é só IPv6 e o Render não alcança.
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# Storage das fotos (chave de serviço fica só no servidor)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Segredo do login do painel. Gere uma string longa e aleatória.
JWT_SECRET=
