# Copie este arquivo para .env e preencha na sua máquina.
# O .env não entra no Git. Nenhum valor abaixo é uma credencial real.

# Servidor da API
PORT=3000

# Origem do front liberada no CORS
CORS_ORIGIN=http://127.0.0.1:4173

# Postgres. No Supabase: Project Settings → Database → Connection string.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres

# Storage das fotos (chave de serviço fica só no servidor)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Segredo do login do painel. Gere uma string longa e aleatória.
JWT_SECRET=
